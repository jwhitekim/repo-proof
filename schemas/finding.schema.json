{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repo-proof.local/schemas/finding.schema.json",
  "title": "RepoProof Finding",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "category", "severity", "confidence", "verification_level", "problem", "evidence", "why_it_matters", "underlying_concepts", "reproduction", "minimal_remediation", "related_files"],
  "properties": {
    "id": {"type": "string", "pattern": "^RP-[A-Z0-9_-]+-[0-9]{3}$"},
    "title": {"type": "string", "minLength": 8},
    "category": {"enum": ["repository_understanding", "design_integrity", "change_discipline", "code_quality", "frontend_responsibility", "frontend_state", "frontend_async_lifecycle", "frontend_architecture", "cs_fundamentals", "database", "transaction_concurrency", "network_io", "application_performance", "caching_distributed", "observability"]},
    "area": {"$ref": "#/$defs/area"},
    "severity": {"enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]},
    "confidence": {"enum": ["HIGH", "MEDIUM", "LOW"]},
    "verification_level": {"enum": ["VERIFIED", "CODE_PROVEN", "SUSPECTED"]},
    "problem": {"type": "string", "minLength": 20},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
    "why_it_matters": {"type": "string", "minLength": 20},
    "underlying_concepts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "reproduction": {"$ref": "#/$defs/reproduction"},
    "minimal_remediation": {"type": "string", "minLength": 10},
    "related_files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "introduced_by": {"type": ["string", "null"]},
    "merged_from": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
  },
  "$defs": {
    "area": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "profile"],
      "properties": {
        "path": {"type": "string"},
        "profile": {"enum": ["core", "frontend-web", "backend-general", "spring-backend", "python-backend", "node-backend"]}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "location", "observation"],
      "properties": {
        "id": {"type": "string"},
        "kind": {"enum": ["CODE", "CONFIG", "DOC", "TEST", "RUNTIME", "QUERY_PLAN", "METRIC", "HISTORY"]},
        "location": {"type": "string"},
        "observation": {"type": "string"},
        "method": {"type": "string"}
      }
    },
    "reproduction": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "steps_or_requirements"],
      "properties": {
        "status": {"enum": ["REPRODUCED", "STATIC_PROOF", "NOT_RUN", "BLOCKED"]},
        "steps_or_requirements": {"type": "string"},
        "result": {"type": ["string", "null"]}
      }
    }
  }
}
